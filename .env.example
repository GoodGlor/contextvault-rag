# ContextVault environment configuration.
# Copy to `.env` and adjust for your local setup.

ENVIRONMENT=development

# Secret used for signing JWTs — MUST be overridden outside development.
# Use at least 32 bytes of randomness (e.g. `openssl rand -hex 32`).
SECRET_KEY=change-me-in-production

# JWT session lifetime, in minutes.
ACCESS_TOKEN_EXPIRE_MINUTES=60

# How long an onboarding invite link stays valid, in hours (admin may override
# per-invite at issue time).
INVITE_EXPIRY_HOURS=72

# Async SQLAlchemy connection string (matches docker-compose defaults).
DATABASE_URL=postgresql+asyncpg://contextvault:contextvault@localhost:5432/contextvault

# Local embedding model (sentence-transformers) and its vector width. The two
# MUST agree with the pgvector column; changing them means re-embedding. bge-m3
# is multilingual (RU/UK/EN) and 1024-dim. Alternative: intfloat/multilingual-e5-large.
# EMBEDDING_MODEL=BAAI/bge-m3
# EMBEDDING_DIM=1024

# Generation (RAG loop). LLM_PROVIDER selects the system-default provider
# (defaults to gemini) and the *_MODEL values are default model ids. Provider
# API keys are NOT set here: each repository supplies its own key through the
# admin UI, encrypted at rest — there is no process-wide provider-key fallback.
# LLM_MAX_TOKENS caps the generated answer length.
# LLM_PROVIDER=gemini
# GEMINI_MODEL=gemini-2.5-flash
# ANTHROPIC_MODEL=claude-opus-4-8
# LLM_MAX_TOKENS=2048

# Optional defaults for `python -m contextvault.cli create-admin`.
# INITIAL_ADMIN_USERNAME=admin
# INITIAL_ADMIN_PASSWORD=change-me

# The wall clock a nightly schedule's time is written in (IANA name). A schedule
# set for "02:00" means two o'clock *here*, not UTC. Validated at startup, so a
# typo stops the process rather than leaving a schedule that never fires.
# SCHEDULE_TIMEZONE=Europe/Kyiv
